# =============================================================
# STREAKPACT Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@yourdomain.com

# --- App Config ---
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=STREAKPACT

# --- Storage ---
VITE_MAX_UPLOAD_SIZE_MB=10
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic

# --- Rate Limiting ---
VITE_MAX_SUBMISSIONS_PER_DAY=3
VITE_MAX_CHALLENGES_PER_USER=10

# --- Feature Flags ---
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_EMAIL_NOTIFICATIONS=true
VITE_ENABLE_GOOGLE_AUTH=true
